{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/leads?task=digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/demo-teardown",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notifications?kind=daily_aim",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/cron/notifications?kind=daily_report",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/notifications?kind=weekly_aim",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/notifications?kind=weekly_report",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/cron/notifications?kind=monthly_aim",
      "schedule": "0 5 1 * *"
    },
    {
      "path": "/api/cron/notifications?kind=monthly_report",
      "schedule": "0 15 28-31 * *"
    },
    {
      "path": "/api/recruiter/cron/poll-meetings",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/followups",
      "schedule": "*/5 * * * *"
    }
  ]
}
